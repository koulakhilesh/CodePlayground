# gita-knowledge-graph/.env.example — copy to .env (gitignored) and fill in
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Community/Desktop only has the default `neo4j` database; named databases
# (e.g. TheGitaProject) require Neo4j Enterprise. Use `neo4j` unless on Enterprise.
NEO4J_DATABASE=neo4j
